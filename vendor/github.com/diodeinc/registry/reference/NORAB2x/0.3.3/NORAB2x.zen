"""NORAB2x Reference Design

u-blox NORA-B2 Bluetooth LE and IEEE 802.15.4 module reference circuit.
Based on Nordic nRF54L15 SoC with integrated PCB trace antenna (NORA-B2x6).

Features:
- Supply: 1.7V to 3.5V single rail
- Radio: Bluetooth 6.0, 802.15.4 (Thread, Matter, Zigbee), proprietary 2.4 GHz
- CPU: Arm Cortex-M33 (128 MHz) + RISC-V coprocessor
- Interfaces: UART, SPI, QSPI, I2C, SWD, NFC, 8x GPIO
- Optional 32.768 kHz crystal for lowest-power LFCLK
- VCC decoupling, reset RC filter, I2C pull-ups

Based on NORA-B2 system integration manual (UBXDOC-465451970-3345).
"""

load("@stdlib/interfaces.zen", "Gpio", "I2c", "Spi", "Qspi", "Uart", "Swd")

# --- Power ---
VCC = io(Power(voltage="1.7V to 3.5V"))
GND = io(Ground)

# --- Data interfaces ---
UART = io(Uart, optional=True, help="UART data (TX/RX from module perspective)")
UART_RTS = io(Gpio, optional=True, help="UART request-to-send (module output)")
UART_CTS = io(Gpio, optional=True, help="UART clear-to-send (module input)")
SPI = io(Spi, optional=True, help="SPI main node (up to 32 MHz)")
SPI_DCX = io(Gpio, optional=True, help="SPI Data/Command for displays")
QSPI = io(Qspi, optional=True, help="QSPI for external flash")
I2C = io(I2c, optional=True)
SWD = io(Swd, help="Serial Wire Debug for programming and debug")

# --- Control ---
RESET_N = io(Net, optional=True, help="Active-low reset input (directly driven)")

# --- NFC ---
NFC1 = io(Net, optional=True, help="NFC antenna pin 1 (P1.02)")
NFC2 = io(Net, optional=True, help="NFC antenna pin 2 (P1.03)")

# --- GPIO ---
GPIO_P0_00 = io(Gpio, optional=True)
GPIO_P0_01 = io(Gpio, optional=True)
GPIO_P0_02 = io(Gpio, optional=True, help="Also connected to RF_CTRL2 (G7)")
GPIO_P0_04 = io(Gpio, optional=True)
GPIO_P1_08 = io(Gpio, optional=True, help="SAADC external reference / GRTC HF clk")
GPIO_P1_09 = io(Gpio, optional=True)
GPIO_P1_10 = io(Gpio, optional=True)
GPIO_P1_13 = io(Gpio, optional=True, help="Also connected to RF_CTRL1 (G5), AIN6")

# --- Wake signals ---
WAKE_HOST = io(Gpio, optional=True, help="Module-to-host wake (P1.14/AIN7)")
WAKE_UP = io(Gpio, optional=True, help="Host-to-module wake (P0.03)")

# --- Configs ---
populate_crystal = config(
    bool,
    default=True,
    help="Populate the 32.768 kHz crystal (Y_LFXO). Set False to DNP and use the internal RC oscillator instead.",
)
i2c_pullup = config(bool, default=True, optional=True, help="Populate I2C pull-up resistors to VCC.")

# --- Internal nets ---
_RST = Net("RST")
_XL1 = Net("XL1")
_XL2 = Net("XL2")

# --- Component imports ---
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Crystal = Module("@stdlib/generics/Crystal.zen")

NORAB206 = Module("github.com/diodeinc/registry/components/u-blox/NORA-B206-00B/NORA-B206-00B.zen")

passive_size = "0402"

# --- Main IC ---
# RF_CTRL1 (G5) and GPIO_P1_13 (J8) are internally connected to nRF P1.13.
# RF_CTRL2 (G7) and GPIO_P0_02 (C8) are internally connected to nRF P0.02.
NORAB206(
    name="U_BLE",
    VCC=VCC,
    VSS=GND,
    EAGP=GND,
    ANT=NotConnected(),
    # UART — SIM §2.4.1 warns 2-wire (TX/RX only) is prone to buffer overruns.
    # Connect UART_RTS and UART_CTS for reliable operation.
    UART_TXD=UART.TX,
    UART_RXD=UART.RX,
    UART_RTS=UART_RTS,
    UART_CTS=UART_CTS,
    # SPI (Port 2 high-speed pins)
    SPI_SCK=SPI.CLK,
    SPI_MOSI=SPI.MOSI,
    SPI_MISO=SPI.MISO,
    SPI_CS=SPI.CS,
    SPI_DCX=SPI_DCX,
    # QSPI
    QSPI_CLK=QSPI.CLK,
    QSPI_CS=QSPI.CS,
    QSPI_D0=QSPI.IO0,
    QSPI_D1=QSPI.IO1,
    QSPI_D2=QSPI.IO2,
    QSPI_D3=QSPI.IO3,
    # I2C
    I2C_SCL=I2C.SCL,
    I2C_SDA=I2C.SDA,
    # SWD
    SWDIO=SWD.SWDIO,
    SWDCLK=SWD.SWCLK,
    # Reset — internal ~14 kΩ pull-up holds RESET_N high (datasheet Table 18).
    # SIM §2.2.2: drive with open-drain or contact switch to reset.
    RESET_N=_RST,
    # Crystal
    XL1=_XL1,
    XL2=_XL2,
    # NFC
    NFC1=NFC1,
    NFC2=NFC2,
    # GPIO (P1.13 shared with RF_CTRL1, P0.02 shared with RF_CTRL2)
    GPIO_P0_00=GPIO_P0_00,
    GPIO_P0_01=GPIO_P0_01,
    GPIO_P0_02=GPIO_P0_02,
    RF_CTRL2=GPIO_P0_02,
    GPIO_P0_04=GPIO_P0_04,
    GPIO_P1_08=GPIO_P1_08,
    GPIO_P1_09=GPIO_P1_09,
    GPIO_P1_10=GPIO_P1_10,
    GPIO_P1_13=GPIO_P1_13,
    RF_CTRL1=GPIO_P1_13,
    # Wake signals
    WAKE_HOST=WAKE_HOST,
    WAKE_UP=WAKE_UP,
)

# --- VCC decoupling ---
# SIM §2.1.1: bypass caps as close as possible to module VCC pins.
Capacitor(
    name="C_VCC_BULK",
    value="10uF",
    package="0805",
    voltage="10V",
    P1=VCC,
    P2=GND,
)

Capacitor(
    name="C_VCC",
    value="100nF",
    package=passive_size,
    voltage="10V",
    P1=VCC,
    P2=GND,
)

# --- Reset ---
# RESET_N has an internal ~14 kΩ pull-up (datasheet Table 18, typ 14 kΩ, range 12-16 kΩ).
# No external pull-up needed. Power-on reset time is typ 0.2 ms, max 2 ms (Table 17).
# SIM §2.2.2: drive with open-drain or contact switch to assert reset externally.

# Input cap filters noise on RESET_N. RC with internal 14 kΩ pull-up ≈ 1.4 ms.
Capacitor(
    name="C_RESET",
    value="100nF",
    package=passive_size,
    P1=_RST,
    P2=GND,
)

# Series resistor exposes RESET_N to integrator for external reset control.
Resistor(
    name="R_RESET_EXT",
    value="0ohm",
    package=passive_size,
    P1=RESET_N,
    P2=_RST,
)

# --- 32.768 kHz crystal ---
# SIM §2.2.3.2: external LFXO for lowest sleep current. Internal LFRC is an alternative.
# EVK crystal: AVX KYOCERA ST3215SB32768E0HPWZZ (32.768 kHz, 20 ppm).
# nRF54L15 has internal load caps (4-18 pF), configured via device tree.
# suppress: bom.match_generic
Crystal(
    name="Y_LFXO",
    frequency="32.768kHz",
    package="3215_2Pin",
    load_capacitance="7pF",
    XIN=_XL1,
    XOUT=_XL2,
    dnp=not populate_crystal,
)

# --- I2C pull-ups ---
# SIM §2.4.3: external pull-ups required, referenced to VCC. 8-10 kΩ for single device.
Resistor(
    name="R_SCL",
    value="10kohm 5%",
    package=passive_size,
    P1=I2C.SCL,
    P2=VCC,
    dnp=not i2c_pullup,
)

Resistor(
    name="R_SDA",
    value="10kohm 5%",
    package=passive_size,
    P1=I2C.SDA,
    P2=VCC,
    dnp=not i2c_pullup,
)

Layout(name="NORAB2x", path="layout/NORAB2x")

