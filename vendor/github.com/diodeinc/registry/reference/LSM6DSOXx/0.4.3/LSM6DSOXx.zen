"""
LSM6DSOXTR — 6-axis IMU with embedded AI (Machine Learning Core + Finite State Machine).
3-axis accelerometer (±2/±4/±8/±16 g) and 3-axis gyroscope (±125 to ±2000 dps).
VDD: 1.71–3.6 V, VDDIO: 1.62–3.6 V. LGA-14L (2.5 × 3.0 × 0.83 mm).
Supports I²C / MIPI I3C / SPI primary interface (Mode 1 configuration).
"""

load("@stdlib/interfaces.zen", "Gpio", "I2c", "Spi")

LSM6DSOXTR = Module("github.com/diodeinc/registry/components/STMicroelectronics/LSM6DSOXTR/LSM6DSOXTR.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
Comms = enum("I2C", "SPI")
I2cAddr = enum("0x6A", "0x6B")

communication = config(
    Comms,
    default="I2C",
    help="Primary interface selection. I2C pulls CS high; SPI uses CS from the bus.",
)
i2c_pullup = config(
    bool,
    default=True,
    help="Populate 4.7 kΩ pull-ups on SCL/SDA to VDDIO. Only relevant in I2C mode.",
)
i2c_address = config(
    I2cAddr,
    default="0x6A",
    help="I2C address. 0x6A = SA0 low, 0x6B = SA0 high. Only relevant in I2C mode.",
)

# ---------------------------------------------------------------------------
# IOs
# ---------------------------------------------------------------------------
VDD = io(Power(voltage="1.71V to 3.6V"))
VDDIO = io(Power(voltage="1.62V to 3.6V"))
GND = io(Ground)

INT1 = io(Gpio, optional=True, help="Programmable interrupt 1 (active-high, push-pull default)")
INT2 = io(Gpio, optional=True, help="Programmable interrupt 2 / DEN")

I2C = io(I2c, optional=True, help="Primary I2C interface (active when communication=I2C)")
SPI = io(Spi, optional=True, help="Primary SPI interface (active when communication=SPI)")

# ---------------------------------------------------------------------------
# Internal nets
# ---------------------------------------------------------------------------
_SDX = Net("SDX")
_SCX = Net("SCX")
_CS = Net("CS")

# ---------------------------------------------------------------------------
# Passive size
# ---------------------------------------------------------------------------
passives_size = "0402"

# ---------------------------------------------------------------------------
# Primary interface wiring (Section 7, Table 1)
# ---------------------------------------------------------------------------
# In I2C mode: CS pulled high via R_CS (VDDIO), SDO/SA0 = address select
# In SPI mode: CS driven by SPI.CS with pull-up to keep deasserted at reset
_is_i2c = communication == Comms("I2C")

_CS_drive = _CS if _is_i2c else SPI.CS
_SCL_PIN = I2C.SCL if _is_i2c else SPI.CLK
_SDA_PIN = I2C.SDA if _is_i2c else SPI.MOSI
_SDO_SA0 = SPI.MISO

# ---------------------------------------------------------------------------
# IC instantiation
# ---------------------------------------------------------------------------
LSM6DSOXTR(
    name="U_IMU",
    CS=_CS_drive,
    SCL=_SCL_PIN,
    SDA=_SDA_PIN,
    SDO_SA0=_SDO_SA0,
    INT1=INT1,
    INT2=INT2,
    VDD=VDD,
    VDDIO=VDDIO,
    GND=GND,
    # Mode 1: SDX and SCX connect to VDDIO or GND (Section 3.1, Table 1)
    SDX=_SDX,
    SCX=_SCX,
    # Auxiliary SPI pins unused in Mode 1
    OCS_AUX=NotConnected(),
    SDO_AUX=NotConnected(),
)

# ---------------------------------------------------------------------------
# Mode 1 pin strapping: SDX/SCX tied to GND (Section 7.1)
# ---------------------------------------------------------------------------
Resistor(
    name="R_SDX",
    value="0ohm",
    package=passives_size,
    P1=_SDX,
    P2=GND,
)
Resistor(
    name="R_SCX",
    value="0ohm",
    package=passives_size,
    P1=_SCX,
    P2=GND,
)

# ---------------------------------------------------------------------------
# Decoupling — 100 nF ceramic per supply pin (Section 7.1, recommended)
# ---------------------------------------------------------------------------
Capacitor(
    name="C_VDD",
    value="100nF",
    voltage="10V",
    package=passives_size,
    P1=VDD,
    P2=GND,
)
Capacitor(
    name="C_VDDIO",
    value="100nF",
    voltage="10V",
    package=passives_size,
    P1=VDDIO,
    P2=GND,
)

# ---------------------------------------------------------------------------
# CS pull-up — 10 kΩ to VDDIO (Section 3.1)
# I2C mode: holds CS high to select I2C interface
# SPI mode: keeps CS deasserted at reset until master drives it
# ---------------------------------------------------------------------------
Resistor(
    name="R_CS",
    value="10kohm",
    package=passives_size,
    P1=_CS_drive,
    P2=VDDIO,
)

# ---------------------------------------------------------------------------
# I2C address select — 10 kΩ on SDO/SA0 (Section 3.1, Table 1)
# SA0 low (GND) = 0x6A, SA0 high (VDDIO) = 0x6B
# Both DNP in SPI mode (SDO/SA0 used as MISO)
# ---------------------------------------------------------------------------
_addr_hi = i2c_address == I2cAddr("0x6B")

Resistor(
    name="R_SA0_HI",
    value="10kohm",
    package=passives_size,
    dnp=(not _is_i2c) or (not _addr_hi),
    P1=_SDO_SA0,
    P2=VDDIO,
)
Resistor(
    name="R_SA0_LO",
    value="10kohm",
    package=passives_size,
    dnp=(not _is_i2c) or _addr_hi,
    P1=_SDO_SA0,
    P2=GND,
)

# ---------------------------------------------------------------------------
# I2C pull-ups — 4.7 kΩ to VDDIO (Section 5.1.1)
# DNP when SPI mode selected or pull-ups disabled
# ---------------------------------------------------------------------------
_pullup_dnp = (not _is_i2c) or (not i2c_pullup)

Resistor(
    name="R_SCL",
    value="4.7kohm",
    package=passives_size,
    dnp=_pullup_dnp,
    P1=_SCL_PIN,
    P2=VDDIO,
)
Resistor(
    name="R_SDA",
    value="4.7kohm",
    package=passives_size,
    dnp=_pullup_dnp,
    P1=_SDA_PIN,
    P2=VDDIO,
)

Layout(
    name="LSM6DSOXx",
    path="layout/LSM6DSOXx",
)

