# pcb:sch C_OUT.C x=-892.5400 y=37.1000 rot=0
# pcb:sch GND.0 x=-1156.7000 y=240.3000 rot=0
# pcb:sch GND.1 x=-1448.8000 y=126.0000 rot=0
# pcb:sch GND.2 x=-890.0000 y=126.0000 rot=0
# pcb:sch GND.3 x=-1309.1000 y=240.3000 rot=0
# pcb:sch ON.0 x=-1362.7765 y=107.1880 rot=0
# pcb:sch R_ON_PD.R x=-1304.0200 y=151.4000 rot=0
# pcb:sch R_QOD.R x=-973.8200 y=37.1000 rot=0
# pcb:sch U1 x=-1271.0000 y=-13.7000 rot=0
# pcb:sch VIN.0 x=-1443.7200 y=-51.8000 rot=0
# pcb:sch VOUT.0 x=-884.9200 y=-51.8000 rot=0
